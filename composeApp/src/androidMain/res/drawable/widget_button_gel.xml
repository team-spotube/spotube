<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#59FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:endColor="#E60A4AAE"
                        android:startColor="#E63EA2F5" />
                    <stroke
                        android:width="1dp"
                        android:color="#B3FFFFFF" />
                </shape>
            </item>
            <item
                android:bottom="1dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="315"
                        android:centerColor="#00FFFFFF"
                        android:centerX="0.5"
                        android:centerY="0.5"
                        android:endColor="#00FFFFFF"
                        android:startColor="#66FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
