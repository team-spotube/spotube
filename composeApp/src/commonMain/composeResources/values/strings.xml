    <!-- Page 4: how it works -->
    <string name="welcome_how_eyebrow">Retro-Modern Architecture</string>
    <string name="welcome_how_title">Pure Hi-Fi, zero middlemen</string>
    <string name="welcome_how_subtitle">Here’s how Spotube orchestrates decentralized playback directly on your machine.</string>
    <string name="welcome_how_status_badge">DIRECT PEER-TO-PEER • 256 KBPS OPUS</string>
    <string name="welcome_how_mockup_title">Blue hour</string>
    <string name="welcome_how_mockup_artist">Spotube · player demonstration</string>
    <string name="welcome_how_mockup_lyric">A little music for the moments in between.</string>
    <string name="welcome_how_step_search_title">1. Decentralized Discovery</string>
    <string name="welcome_how_step_search_desc">Queries go straight to your chosen catalog plugin. Spotube never profiles your taste.</string>
    <string name="welcome_how_step_stream_title">2. Direct Stream Resolution</string>
    <string name="welcome_how_step_stream_desc">Audio streams directly from content servers to your machine. No proxy hops or remote data harvesting.</string>
    <string name="welcome_how_step_playback_title">3. Local DSP &amp; Playback</string>
    <string name="welcome_how_step_playback_desc">Decoded and cached locally with equalizer controls and optional offline download.</string>
    <string name="welcome_how_step_lyrics_title">4. Synced Lyrics &amp; Jam</string>
    <string name="welcome_how_step_lyrics_desc">Karaoke lyrics track the playback timestamp, with LAN remote control and Group Jam.</string>
    <string name="welcome_how_footer">No middleman servers. Playback happens right on your device — private by design.</string>
</resources>
