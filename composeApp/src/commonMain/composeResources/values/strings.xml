    <string name="welcome_plugins_eyebrow">Modular Architecture</string>
    <string name="welcome_plugins_title">Choose where your music comes from.</string>
    <string name="welcome_plugins_subtitle">Spotube separates catalog discovery, audio streaming, and synced lyrics. Configure your engines below or switch them anytime.</string>
