{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "compose-hot-reload": {
      "enabled": true,
      "disabled": false,
      "type": "local",
      "command": [
        "./gradlew",
        "--no-daemon",
        "--quiet",
        "--console=plain",
        "hotMcpServer"
      ]
    },
    "studio": {
      "url": "http://127.0.0.1:64342/stream",
      "type": "remote"
    }
  }
}