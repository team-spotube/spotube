{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spotube-jam",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "JAM_ROOM", "class_name": "JamRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JamRoom"] }],
  // Room connects per client IP: slows down code guessing and connection floods, which
  // wake (and bill) rooms. Generous because carrier-grade NAT puts many phones behind
  // one IP. Enforced per Cloudflare location, so approximate.
  "ratelimits": [
    { "name": "CONNECT_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ]
}
